# ============================================================================
# RVS GESTOR WHATSAPP BACKEND CONFIGURATION
# Copy this file to '.env' and fill in your actual credentials.
# ============================================================================

PORT=3001

# 1. Supabase Postgres Connection String
# Get this from your Supabase Dashboard under Settings -> Database -> Connection string (URI)
# Format: postgresql://postgres:[PASSWORD]@db.xjtluflzpkkbckkcwagf.supabase.co:6543/postgres
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.xjtluflzpkkbckkcwagf.supabase.co:6543/postgres"

# 2. Evolution API Configuration
# Get these credentials from your Evolution API host panel
EVOLUTION_API_URL="https://sua-vps.com"
EVOLUTION_API_KEY="SUA_API_KEY_GLOBAL_AQUI"
EVOLUTION_INSTANCE_NAME="escola_rvs3"
